msgctxt "model:ir.message,text:msg_product_supplier_validation"
msgid ""
"Purchase \"%(purchase)s\" cannot be processed because product "
"\"%(product)s\" has not been validated for supplier \"%(supplier)s\"."
msgstr ""
"A(z) „%(purchase)s” beszerzés nem dolgozható fel, mert a(z) „%(product)s” "
"termék nincs jóváhagyva a(z) „%(supplier)s” szállítóhoz."

msgctxt "model:res.group,name:group_purchase_validation"
msgid "Purchase Validation"
msgstr "Beszerzési jóváhagyás"
